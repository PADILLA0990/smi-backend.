# Copie este archivo como .env y complete los valores. Nunca suba .env a git.

# --- Base de datos (Supabase) ---
# Conexión por el pooler (puerto 6543) para la app
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) para migraciones
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres"

# --- Autenticación ---
# OBLIGATORIO, mínimo 32 caracteres. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Duración del token de acceso (minutos) y de la sesión (horas, un turno)
ACCESO_MINUTOS=15
SESION_HORAS=10
# Bloqueo: intentos fallidos por usuario y minutos de bloqueo
MAX_INTENTOS=5
BLOQUEO_MINUTOS=15
# Intentos fallidos por IP cada 15 minutos
LIMITE_LOGIN_IP=20

# --- Red ---
# Orígenes permitidos (separados por coma)
CORS_ORIGINS="https://smi-frontend-murex.vercel.app,http://localhost:5173"
# Proxies delante del servidor (Vercel + Render = 2)
TRUST_PROXY=2
# La cookie de sesión es Secure (solo HTTPS) salvo COOKIE_SEGURA=false
NODE_ENV=production
PORT=3000
