generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id                 String   @id @default(uuid())
  codigo_producto    String   @unique
  descripcion        String
  categoria          String
  cantidad           Int
  estado             String
  fecha_ingreso      DateTime @default(now())
  ubicacion_general  String   
  codigo_estanteria  String?  
}