generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id                Int      @id @default(autoincrement())
  codigo_producto   String   @unique
  descripcion       String
  categoria         String
  cantidad          Int
  estado            String
  ubicacion_general String
  codigo_estanteria String?
  fecha_ingreso     DateTime @default(now())
}

model Historial {
  id              Int      @id @default(autoincrement())
  codigo_producto String
  accion          String   
  operario        String   
  detalles        String?  
  fecha           DateTime @default(now())
}