generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id                 Int        @id @default(autoincrement())
  codigo_producto    String     @unique
  descripcion        String
  categoria          String
  cantidad           Int
  cantidad_reservada Int        @default(0) // Apartada por Solicitudes SBO aprobadas, aún no despachadas
  estado             String
  ubicacion_general  String
  codigo_estanteria  String?
  fecha_ingreso      DateTime   @default(now())
  // Fase C: catálogos y atributos (opcionales para no afectar productos existentes)
  categoriaId        Int?
  categoriaRef       Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  talla              String?
  condicion          Condicion?
  grupo              String? // Género o grupo etario (lista fija en lib/catalogos.js)
  stock_minimo       Int? // Vacío: se usa el parámetro stock_minimo_defecto
  activo             Boolean    @default(true)

  @@index([categoriaId])
}

model Historial {
  id              Int        @id @default(autoincrement())
  codigo_producto String
  accion          String
  operario        String // Nombre de usuario de quien hizo el movimiento (texto: conserva los registros previos a la Fase B)
  detalles        String?
  fecha           DateTime   @default(now())
  usuarioId       Int? // Usuario autenticado (vacío en registros anteriores a la Fase B)
  usuario         Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  documentoId     Int? // Fase D2: documento de ingreso o salida al que pertenece el movimiento
  documento       Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([documentoId])
}

// --- MÓDULO DE SOLICITUDES SBO ---

enum EstadoSolicitud {
  CREADA
  APROBADA
  EN_ALISTAMIENTO
  ALISTADA
  DESPACHADA
  CANCELADA
  VENCIDA // 30 días (configurable) sin movimiento: libera la reserva
}

model Solicitud {
  id                        Int               @id @default(autoincrement())
  codigo_sbo                String            @unique
  beneficiario              String // Nombre de la organización al crear (texto: conserva solicitudes antiguas)
  organizacionId            Int?
  organizacion              Organizacion?     @relation(fields: [organizacionId], references: [id], onDelete: SetNull)
  estado                    EstadoSolicitud   @default(CREADA)
  creado_por                String
  alistador                 String?
  observaciones             String?
  fecha_solicitud           DateTime          @default(now())
  fecha_requerida           DateTime?
  fecha_aprobacion          DateTime?
  fecha_inicio_alistamiento DateTime?
  fecha_fin_alistamiento    DateTime?
  fecha_despacho            DateTime?
  fecha_cancelacion         DateTime?
  fecha_vencimiento         DateTime?
  items                     SolicitudItem[]
  eventos                   SolicitudEvento[]

  @@index([organizacionId])
}

model SolicitudItem {
  id                  Int       @id @default(autoincrement())
  solicitudId         Int
  solicitud           Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  codigo_producto     String // Texto (no FK): Producto se elimina cuando su stock llega a 0
  descripcion         String // Copia de la descripción al momento de crear la solicitud
  cantidad_solicitada Int
  cantidad_alistada   Int       @default(0)

  @@index([solicitudId])
}

model SolicitudEvento {
  id              Int              @id @default(autoincrement())
  solicitudId     Int
  solicitud       Solicitud        @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  estado_anterior EstadoSolicitud?
  estado_nuevo    EstadoSolicitud
  usuario         String
  nota            String?
  fecha           DateTime         @default(now())

  @@index([solicitudId])
}

// --- USUARIOS, ROLES Y SESIONES (Fase B) ---

enum Rol {
  ADMINISTRADOR
  COORDINADOR
  OPERARIO
  CONSULTA
}

model Usuario {
  id                    Int             @id @default(autoincrement())
  nombre                String
  usuario               String          @unique
  password_hash         String
  rol                   Rol             @default(OPERARIO)
  activo                Boolean         @default(true)
  debe_cambiar_password Boolean         @default(true)
  intentos_fallidos     Int             @default(0)
  bloqueado_hasta       DateTime?
  ultimo_acceso         DateTime?
  creado_en             DateTime        @default(now())
  actualizado_en        DateTime        @updatedAt
  sesiones              SesionRefresh[]
  historial             Historial[]
  documentos            Documento[]
}

model SesionRefresh {
  id          Int       @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token_hash  String    @unique // SHA-256 del token: el token en claro solo vive en la cookie
  expira      DateTime
  revocada_en DateTime?
  ip          String?
  user_agent  String?
  creado_en   DateTime  @default(now())

  @@index([usuarioId])
}

// --- CATÁLOGOS Y PARÁMETROS (Fase C) ---
// Nunca se borran registros de catálogo: se desactivan (activo = false).

enum Condicion {
  PERFECTO
  BUENO
  DETERIORO
  DANADO
}

enum TipoTercero {
  DONANTE
  PROVEEDOR
  AMBOS
}

enum TipoMotivo {
  SALIDA
  AJUSTE
  NOVEDAD
}

model Categoria {
  id             Int        @id @default(autoincrement())
  nombre         String     @unique
  prefijo        String?    @unique // Prefijo sugerido para códigos de producto (ROP, APP…)
  descripcion    String?
  activo         Boolean    @default(true)
  creado_en      DateTime   @default(now())
  actualizado_en DateTime   @updatedAt
  productos      Producto[]
}

model Organizacion {
  id             Int         @id @default(autoincrement())
  nombre         String      @unique
  nit            String?     @unique
  contacto       String?
  telefono       String?
  correo         String?
  localidad      String?
  direccion      String?
  activo         Boolean     @default(true)
  creado_en      DateTime    @default(now())
  actualizado_en DateTime    @updatedAt
  solicitudes    Solicitud[]
  documentos     Documento[]
}

model Tercero {
  id             Int         @id @default(autoincrement())
  tipo           TipoTercero @default(DONANTE)
  nombre         String      @unique
  nit            String?     @unique
  contacto       String?
  telefono       String?
  correo         String?
  activo         Boolean     @default(true)
  creado_en      DateTime    @default(now())
  actualizado_en DateTime    @updatedAt
  documentos     Documento[]
}

model Motivo {
  id             Int        @id @default(autoincrement())
  tipo           TipoMotivo
  nombre         String
  activo         Boolean    @default(true)
  creado_en      DateTime   @default(now())
  actualizado_en DateTime   @updatedAt

  documentos Documento[]

  @@unique([tipo, nombre])
}

model UnidadManejo {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique
  abreviatura    String?
  factor         Int      @default(1) // Cuántas unidades de inventario equivale
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt
}

model Ubicacion {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique // Lo que se guarda en Producto.codigo_estanteria (o ubicacion_general para Recepción)
  nombre         String?
  zona           String?
  estante        String?
  nivel          String?
  posicion       String?
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt
  // Mapa de Bodega: hueco generado por una estantería (vacío en áreas como Recepción o Alistamiento)
  estanteriaId   Int?
  estanteria     Estanteria? @relation(fields: [estanteriaId], references: [id], onDelete: SetNull)

  @@index([estanteriaId])
}

// Mapa de Bodega: rack abierto de N niveles (1 = abajo) por M huecos. Al guardarlo se generan sus
// ubicaciones con código Z1-A-2-04 (zona-rack-nivel-hueco). Sin capacidad: el piso controla el espacio.
model Estanteria {
  id             Int         @id @default(autoincrement())
  codigo         String      @unique // Z1-A
  zona           String // Z1
  rack           String // A
  calle          String? // Nombre de la calle o pasillo (Koaj, Koller…)
  niveles        Int
  huecos         Int
  orden          Int         @default(0)
  activo         Boolean     @default(true)
  creado_en      DateTime    @default(now())
  actualizado_en DateTime    @updatedAt
  ubicaciones    Ubicacion[]
}

model Parametro {
  clave          String   @id
  valor          String
  actualizado_en DateTime @updatedAt
}

// --- DOCUMENTOS DE INGRESO Y SALIDA (Fase D2) ---
// Un documento agrupa varias líneas que se registran en una sola transacción.
// Los nombres del catálogo se copian al guardar: el comprobante no cambia si luego se edita el catálogo.

enum TipoDocumento {
  INGRESO
  SALIDA
}

enum OrigenIngreso {
  DONACION
  COMPRA
}

model Documento {
  id                  Int              @id @default(autoincrement())
  tipo                TipoDocumento
  consecutivo         Int // Por tipo, sin año: ING-0001, SAL-0001
  numero              String           @unique
  fecha               DateTime         @default(now())
  origen              OrigenIngreso? // Solo ingresos
  terceroId           Int? // Donante o proveedor (ingresos, opcional)
  tercero             Tercero?         @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  tercero_nombre      String?
  soporte             String? // Remisión, factura o acta del donante
  motivoId            Int? // Motivo de salida (salidas)
  motivo              Motivo?          @relation(fields: [motivoId], references: [id], onDelete: SetNull)
  motivo_nombre       String?
  organizacionId      Int? // Organización destino (salidas, opcional)
  organizacion        Organizacion?    @relation(fields: [organizacionId], references: [id], onDelete: SetNull)
  organizacion_nombre String?
  observaciones       String?
  operario            String
  usuarioId           Int?
  usuario             Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  lineas              DocumentoLinea[]
  historial           Historial[]

  @@unique([tipo, consecutivo])
  @@index([fecha])
}

model DocumentoLinea {
  id              Int        @id @default(autoincrement())
  documentoId     Int
  documento       Documento  @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  codigo_producto String // Texto (no FK), como en SolicitudItem
  descripcion     String
  condicion       Condicion? // La del producto al registrar (cada condición tiene su propio código)
  unidad          String // Unidad de manejo (copia del catálogo)
  factor          Int
  cantidad_manejo Int // Cantidad en la unidad de manejo
  cantidad        Int // Unidades de inventario: cantidad_manejo × factor
  producto_nuevo  Boolean    @default(false)

  @@index([documentoId])
}
